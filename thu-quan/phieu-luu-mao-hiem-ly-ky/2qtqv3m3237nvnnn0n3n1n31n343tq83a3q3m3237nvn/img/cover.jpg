	function findPosX(obj)
	{
		var curleft = 0;
		if (obj.offsetParent)
		{
			while (obj.offsetParent)
			{
				curleft += obj.offsetLeft
				obj = obj.offsetParent;
			}
		}
		else if (obj.x)
			curleft += obj.x;
		return curleft;
	}
	
	function HAll(){
		if(MoS!='amlich'){
		    var amlich = document.getElementById('amlich');
			if (amlich) amlich.style.visibility="hidden";
		}
		
	}
	
	function SSub(selId){
		MoS=selId;
		sm=document.getElementById(selId);
		var m=findPosX(document.getElementById('Mamlich'))+ -20;
		HAll();
		sm.style.left=5+"px";
		sm.style.top="143px";
		sm.style.visibility="visible";
	}
	
	function HSub(){
		setTimeout('HAll()', 1000);
	}

</script>
